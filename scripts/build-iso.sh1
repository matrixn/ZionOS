
#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v docker >/dev/null || {
  echo "Docker CLI required."
  exit 1
}

"$ROOT/scripts/build-core.sh"

mkdir -p "$ROOT/build/iso"

docker run --rm --privileged -i \
  -v "$ROOT:/workspace" \
  -w /workspace \
  alpine:3.23 sh -e <<'ALPINE_SCRIPT'

apk add --no-cache \
  alpine-sdk abuild alpine-conf \
  syslinux xorriso squashfs-tools \
  grub grub-efi mtools git openssl

mkdir -p \
  /root/.abuild \
  /root/.mkimage \
  /workspace/build/iso

abuild-keygen -a -n
cp /root/.abuild/*.rsa.pub /etc/apk/keys/

git clone --depth=1 --branch 3.23-stable \
  https://gitlab.alpinelinux.org/alpine/aports.git \
  /tmp/aports

# Temporary compatibility patch.
# Fail explicitly if the expected expression is absent.
if grep -Fq -- 'add --initdb --no-chown' \
  /tmp/aports/scripts/mkimage.sh; then

  sed -i \
    's|add --initdb --no-chown|add --initdb|g' \
    /tmp/aports/scripts/mkimage.sh

  echo "Applied mkimage compatibility patch."
fi 

cp /workspace/platform/alpine/genapkovl-zionos.sh \
  /root/.mkimage/genapkovl-zionos.sh

chmod +x /root/.mkimage/genapkovl-zionos.sh

export ZION_STAGE=/workspace/build/stage
export ZION_APKOVL_SCRIPT=genapkovl-zionos.sh

test -x /root/.mkimage/genapkovl-zionos.sh || {
  echo "ERROR: ZionOS overlay generator missing"
  exit 1
}

echo "ZionOS overlay generator ready."

/tmp/aports/scripts/mkimage.sh \
  --tag 0.1.0 \
  --arch x86_64 \
  --profile zionos \
  --repository https://dl-cdn.alpinelinux.org/alpine/v3.23/main \
  --outdir /workspace/build/iso \
  --workdir /tmp/zionos-mkimage

ALPINE_SCRIPT

echo "ISO files:"
ls -lh "$ROOT"/build/iso/*.iso
