#!/bin/sh
# Read-only shared inspection. Unsafe formatting is suspended until a pinned executor exists.
set -eu
case "${1:---plan}" in
  --plan|--validate) exec /opt/zionos/bin/zion-core --lab-plan;;
  --apply)
    echo 'ZionOS LAB DENIED: --apply is disabled in Genesis 0.6.1; no verified exclusive formatting executor.' >&2
    exit 1;;
  *) echo 'Usage: zion-lab-provision [--plan | --validate]; --apply is disabled' >&2; exit 2;;
esac
